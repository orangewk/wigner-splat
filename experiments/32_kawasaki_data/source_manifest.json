      "status": "source-wording-conflict",
      "article_convention": "[x,p]=i (hbar=1)",
      "dryad_readme_convention": "dimensionless unit with hbar=1/2",
      "loader_rule": "Do not rescale in the loader. The later fit protocol fixes raw scale as primary and sqrt(2) as a sensitivity arm."
    },
